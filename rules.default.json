  { "id": "github-token", "name": "GitHub token", "type": "regex", "pattern": "\\bgh[pousr]_[A-Za-z0-9]{36,}\\b", "mode": "mask", "enabled": true },
  { "id": "api-key", "name": "API key (sk-…)", "type": "regex", "pattern": "\\bsk-(?:ant-)?[A-Za-z0-9_\\-]{20,}\\b", "mode": "mask", "enabled": true },
  { "id": "jwt", "name": "JWT", "type": "regex", "pattern": "\\beyJ[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\.[A-Za-z0-9_-]{10,}\\b", "mode": "log", "enabled": true }
