[
  { "id": "private-key", "name": "Private key", "type": "regex", "pattern": "-----BEGIN (?:[A-Z]+ )?PRIVATE KEY-----[\\s\\S]*?(?:-----END (?:[A-Z]+ )?PRIVATE KEY-----|$)", "mode": "block", "enabled": true },
